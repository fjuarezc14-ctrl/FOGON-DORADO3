FROM node:20-alpine

WORKDIR /app

# Instalar dependencias del sistema para Prisma
RUN apk add --no-cache openssl

COPY package.json ./
RUN npm install

# Copiar el schema de Prisma para generar el cliente
# (Las migraciones se aplicarán en tiempo de ejecución, no de construcción)
COPY prisma ./prisma
RUN npx prisma generate

COPY . .

EXPOSE 3002

# Al iniciar: aplicar TODAS las migraciones pendientes y luego arrancar el servidor.
# NOTA: El seed.js ya NO se ejecuta aquí para evitar errores por datos duplicados en producción.
# Si necesitas datos iniciales, corre manualmente: docker compose exec backend node prisma/seed.js
CMD ["sh", "-c", "npx prisma migrate deploy && node server.js"]
